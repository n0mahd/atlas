{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "permissions": {
    "allow": [
      "Bash(cargo test:*)"
    ],
    "deny": [
      "Read(./.env)"
    ]
  },
  "skillOverrides": {
    "legacy-context": "name-only",
    "deploy": "off"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/atlas/store/hooks/reminder/run.sh # atlas:reminder"
          }
        ]
      }
    ]
  }
}
