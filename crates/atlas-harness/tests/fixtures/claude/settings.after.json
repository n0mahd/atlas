{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "permissions": {
    "allow": [
      "Bash(cargo test *)",
      "Bash(git status)"
    ],
    "deny": [
      "Read(./.env)"
    ]
  },
  "env": {
    "EXAMPLE_FLAG": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/block-force-push.sh",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/no-worktrees.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/atlas/store/hooks/guard/run.sh # atlas:guard",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/atlas/store/hooks/format-on-save/run.sh # atlas:format-on-save",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "npx prettier --write \"$CLAUDE_FILE_PATHS\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo 'remember the style guide'"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/atlas/store/hooks/session-note/run.sh # atlas:session-note"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/atlas/store/hooks/prompt-log/run.sh # atlas:prompt-log",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "theme": "dark"
}
