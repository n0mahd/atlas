# atlasd: keeps this login's agents in step with the owner's signed updates.
# One per OS account on each machine, as a user service; never as root.
# The hub's install script (curl <hub>/install | sh -s -- <code>) writes this file and
# atlasd.timer to ~/.config/systemd/user and enables the timer.
#
# Links an older setup made can be handed over to atlasd by listing the folders they
# point into under `adopt` in ~/.config/atlas/client.toml (or `atlasd pair --adopt DIR`);
# atlasd then repoints them into its own copies.
[Unit]
Description=Atlas client: apply the latest signed update

[Service]
Type=oneshot
ExecStart=%h/.local/bin/atlasd run
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
# Home stays writable: harness configs, links and local copies live there.
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
ProtectKernelTunables=yes
SystemCallArchitectures=native
TimeoutStartSec=10min
