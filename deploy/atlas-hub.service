# User service for the Atlas hub. Install:
#   cargo build --release -p atlas-hub && install -Dm755 target/release/atlas-hub ~/.local/bin/atlas-hub
#   ln -sf "$PWD/deploy/atlas-hub.service" ~/.config/systemd/user/ && systemctl --user daemon-reload
#   systemctl --user enable --now atlas-hub
#   loginctl enable-linger "$USER"   # keep it running without a login session
#   tailscale serve --bg --https=<port> "unix:$XDG_RUNTIME_DIR/atlas/hub.sock"
[Unit]
Description=Atlas hub (web UI over a Unix socket for tailscale serve)

[Service]
ExecStart=%h/.local/bin/atlas-hub
Restart=on-failure
RuntimeDirectory=atlas
RuntimeDirectoryMode=0700
# Passkeys and settings live in ~/.local/state/atlas-hub.
StateDirectory=atlas-hub
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
# The web UI is a Unix socket; INET is only for git push when the owner turns it on.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectSystem=strict
# Home stays writable: edits commit to the store and project repos there.
LockPersonality=yes
MemoryDenyWriteExecute=yes
ProtectKernelTunables=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native
MemoryMax=512M
TasksMax=64

[Install]
WantedBy=default.target
