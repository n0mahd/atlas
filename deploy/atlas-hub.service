# User service for the Atlas hub. deploy/install.sh copies it to
# ~/.config/systemd/user/ and enables it; by hand, copy it there (don't link it into the
# clone, which may move or change branch), then:
#   systemctl --user daemon-reload && systemctl --user enable --now atlas-hub
#   loginctl enable-linger "$USER"   # keep it running without a login session
#   tailscale serve --bg --https=<port> "unix:$XDG_RUNTIME_DIR/atlas/hub.sock"
[Unit]
Description=Atlas hub (web UI over a Unix socket for tailscale serve)

[Service]
ExecStart=%h/.local/bin/atlas-hub
Restart=on-failure
RuntimeDirectory=atlas
RuntimeDirectoryMode=0700
# Passkeys and settings live in ~/.local/state/atlas-hub.
StateDirectory=atlas-hub
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
# The web UI is a Unix socket; INET is for git push and for installing atlasd over SSH.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# No PrivateTmp, ProtectSystem or ProtectKernelTunables (decision 0025): in a user service
# they put the hub in a user namespace where root's files look owned by nobody, and ssh
# then refuses /etc/ssh/ssh_config.d/*. The hub runs as its user, who can't write /usr,
# /etc or /proc/sys anyway, and home must stay writable for commits.
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native
MemoryMax=512M
TasksMax=64

[Install]
WantedBy=default.target
