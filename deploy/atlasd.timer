# Runs atlasd.service every minute. See atlasd.service for install steps. A run with
# nothing new is one release GET and one report POST and writes nothing on this machine.
[Unit]
Description=Run atlasd every minute

[Timer]
OnBootSec=2min
OnCalendar=*:*:00
Persistent=true

[Install]
WantedBy=timers.target
